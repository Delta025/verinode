# Verinode — Environment Configuration
# Copy this file to .env and modify as needed.

# ─── Graph Storage ───────────────────────────────────────────────
# Path to the knowledge graph file. Supports .db (SQLite) or .json.
VERINODE_GRAPH=verinode_graph.db

# ─── LLM Backend ─────────────────────────────────────────────────
# Ollama model for fact extraction and contradiction detection.
VERINODE_MODEL=qwen3:14b

# Ollama server URL (only needed if Ollama is on a remote host).
# OLLAMA_HOST=http://localhost:11434

# ─── Gemini Backend (optional) ───────────────────────────────────
# Set backends to "gemini" to use Google Gemini instead of Ollama.
# Requires a valid VERINODE_GEMINI_API_KEY.
# VERINODE_CHECKER_BACKEND=ollama
# VERINODE_EXTRACTOR_BACKEND=ollama
# VERINODE_GEMINI_API_KEY=your-gemini-api-key-here
# VERINODE_GEMINI_MODEL=gemini-3.8-flash

# ─── Windows Compatibility ───────────────────────────────────────
# Set to 1 to prevent tqdm/stderr crashes on Windows.
# TQDM_DISABLE=1

# Engram AI — Environment Configuration
# Copy this file to .env and modify as needed.

# ─── Graph Storage ───────────────────────────────────────────────
# Path to the knowledge graph file. Supports .db (SQLite) or .json.
ENGRAM_GRAPH=engram_graph.db

# ─── LLM Backend ─────────────────────────────────────────────────
# Ollama model for fact extraction and contradiction detection.
ENGRAM_MODEL=qwen3:14b

# Ollama server URL (only needed if Ollama is on a remote host).
# OLLAMA_HOST=http://localhost:11434

# ─── Gemini Backend (optional) ───────────────────────────────────
# Set backends to "gemini" to use Google Gemini instead of Ollama.
# Requires a valid ENGRAM_GEMINI_API_KEY.
# ENGRAM_CHECKER_BACKEND=ollama
# ENGRAM_EXTRACTOR_BACKEND=ollama
# ENGRAM_GEMINI_API_KEY=your-gemini-api-key-here

# ─── Windows Compatibility ───────────────────────────────────────
# Set to 1 to prevent tqdm/stderr crashes on Windows.
# TQDM_DISABLE=1
